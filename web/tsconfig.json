{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "strict": true, "allowJs": true, "checkJs": false, "isolatedModules": true,
    "verbatimModuleSyntax": true, "resolveJsonModule": true, "skipLibCheck": true,
    "noEmit": true, "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["svelte", "vite/client", "bun"]
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "tests/**/*.ts", "scripts/**/*.ts", "vite.config.ts", "svelte.config.js"]
}
